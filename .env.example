# -------------------------------------------------------
# Variables de entorno para sgrai-api
# Copiar este archivo como .env.local y completar los valores.
# -------------------------------------------------------

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/sgrai

# Redis (caché y colas)
REDIS_URL=redis://localhost:6379

# Puerto del servidor (Next.js usa 3000 por defecto)
PORT=3000

# Entorno
NODE_ENV=development
