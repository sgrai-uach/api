# -------------------------------------------------------
# Variables de entorno para sgrai-api
# Copiar este archivo como .env.local y completar los valores.
# -------------------------------------------------------

# PostgreSQL + PostGIS
# - Desarrollo: localhost:5432
# - Docker producción: grupo1_postgres:5432 (interno)
# - Docker desarrollo: postgres:5432 (interno), host:5001 (externo)
DATABASE_URL=postgresql://sgrai:sgrai_dev@localhost:5432/sgrai

# Redis (caché y colas)
# - Desarrollo: localhost:6379
# - Docker producción: grupo1_redis:6379 (interno)
# - Docker desarrollo: redis:6379 (interno), host:6001 (externo)
REDIS_URL=redis://localhost:6379

# Puerto del servidor
# - Desarrollo local: 3000 (sgrai-web usa 3001 en desarrollo)
# - Docker producción: 4001 (Caddy redirige /api/* → grupo1_backend:4001)
PORT=3000

# Entorno
NODE_ENV=development

# Autenticación y Sesiones
JWT_SECRET=super-secreto-seguridad-sgrai-valdivia-2026-min-32-chars
JWT_EXPIRES_IN=8h
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Variables para docker-compose (no usadas en desarrollo local)
# POSTGRES_USER=sgrai
# POSTGRES_PASSWORD=<secreto>
# POSTGRES_DB=sgrai
