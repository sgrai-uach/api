# -------------------------------------------------------
# Variables de entorno para sgrai-api
# Copiar este archivo como .env.local y completar los valores.
# -------------------------------------------------------

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://sgrai:sgrai_dev@localhost:5432/sgrai

# Redis (caché y colas)
REDIS_URL=redis://localhost:6379

# Puerto del servidor (sgrai-web usa 3000, sgrai-api usa 3001 por defecto)
PORT=3001

# Entorno
NODE_ENV=development
